# Serve the installer as plain text, never as HTML, and don't let a CDN pin a
# stale copy of it for long.
/install
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/favicon.ico
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400

/favicon.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=86400

/og-image.png
  Content-Type: image/png
  Cache-Control: public, max-age=3600, must-revalidate

# All public static surfaces use same-origin external code and styles.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'none'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
