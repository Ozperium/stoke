{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Editorial product storytelling with a drawn policy-first request path.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.098,
          0.098,
          0.098
        ],
        "hex": "#191919"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.988,
          0.988,
          0.988
        ],
        "hex": "#fcfcfc"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.945,
          0.325,
          0.196
        ],
        "hex": "#f15332"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Sora",
        "fontSize": {
          "value": 4.8,
          "unit": "rem"
        },
        "fontWeight": 620,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Source Sans 3",
        "fontSize": {
          "value": 1.05,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    }
  }
}
